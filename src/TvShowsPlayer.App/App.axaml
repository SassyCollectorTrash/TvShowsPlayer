<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TvShowsPlayer.App.App">
  <Application.Styles>
    <FluentTheme />
  </Application.Styles>
  <TrayIcon.Icons>
    <TrayIcons>
      <TrayIcon Icon="/Assets/icon.png" ToolTipText="LocalTV — канал с сериалами" IsVisible="False">
        <TrayIcon.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Пауза / продолжить" Click="OnPausePlay" />
            <NativeMenuItem Header="Громче" Click="OnVolumeUp" />
            <NativeMenuItem Header="Тише" Click="OnVolumeDown" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Следующая серия" Click="OnNextEpisode" />
            <NativeMenuItem Header="Следующий сериал" Click="OnNextShow" />
            <NativeMenuItem Header="Показать, что идёт сейчас" Click="OnShowNow" />
            <NativeMenuItem Header="Починить звук (если отстаёт от картинки)" Click="OnResync" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Без звука" ToggleType="CheckBox" Click="OnToggleCall" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Поискать новые сериалы" Click="OnRefreshLibrary" />
            <NativeMenuItem Header="Перезапустить канал" Click="OnRestartChannel" />
            <NativeMenuItem Header="Настройки…" Click="OnSettings" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Выход" Click="OnQuit" />
          </NativeMenu>
        </TrayIcon.Menu>
      </TrayIcon>
    </TrayIcons>
  </TrayIcon.Icons>
</Application>
