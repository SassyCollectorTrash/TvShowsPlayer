<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TvShowsPlayer.App.SettingsWindow"
        Title="LocalTV — Настройки"
        Icon="/Assets/icon.png"
        Width="780" Height="560"
        MinWidth="640" MinHeight="440"
        RequestedThemeVariant="Dark"
        Background="#313338"
        WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <!-- сайдбар-вкладки (как категории Discord) -->
    <Style Selector="TabControl">
      <Setter Property="Background" Value="#313338" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="TabItem">
      <Setter Property="Width" Value="192" />
      <Setter Property="Height" Value="40" />
      <Setter Property="Margin" Value="8,2" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="#b5bac1" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="TabItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#35373c" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="TabItem:selected">
      <Setter Property="Foreground" Value="#ffffff" />
    </Style>
    <Style Selector="TabItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#404249" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- типографика -->
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#f2f3f5" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="#b5bac1" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Margin" Value="0,18,0,6" />
    </Style>

    <!-- поля ввода -->
    <Style Selector="TextBox">
      <Setter Property="Background" Value="#1e1f22" />
      <Setter Property="Foreground" Value="#dbdee1" />
      <Setter Property="CaretBrush" Value="#dbdee1" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#1e1f22" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="#5865F2" />
    </Style>
    <Style Selector="NumericUpDown">
      <Setter Property="Background" Value="#1e1f22" />
      <Setter Property="Foreground" Value="#dbdee1" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="MinWidth" Value="170" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="Background" Value="#1e1f22" />
      <Setter Property="Foreground" Value="#dbdee1" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="#2b2d31" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Foreground" Value="#dbdee1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Margin" Value="0,1" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="#404249" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="#dbdee1" />
      <Setter Property="Margin" Value="0,12,0,0" />
    </Style>

    <!-- кнопки -->
    <Style Selector="Button">
      <Setter Property="Background" Value="#4e5058" />
      <Setter Property="Foreground" Value="#ffffff" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#6d6f78" />
    </Style>
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="#5865F2" />
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#4752c4" />
    </Style>

    <!-- пульсирующая точка LIVE -->
    <Style Selector="Ellipse.live">
      <Style.Animations>
        <Animation Duration="0:0:1.3" IterationCount="INFINITE">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1.0" /></KeyFrame>
          <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.25" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1.0" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="*,Auto">
    <TabControl TabStripPlacement="Left" Grid.Row="0">

      <TabItem Header="Сериалы">
        <StackPanel Margin="28,24" MaxWidth="540" HorizontalAlignment="Left">
          <TextBlock Classes="section" Text="Сериалы" />
          <TextBlock Classes="label" Text="ПАПКА С СЕРИАЛАМИ" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Grid.Column="0" x:Name="CartoonsRootBox" Text="{Binding CartoonsRoot, Mode=TwoWay}" />
            <Button Grid.Column="1" Content="Выбрать…" Click="OnBrowseCartoons" Margin="8,0,0,0" />
          </Grid>
          <TextBlock Text="Внутри должна быть отдельная папка на каждый сериал, а в ней — файлы серий. Например: Сериалы \ Чип и Дейл \ Серия 01.mkv"
                     Foreground="#949ba4" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />

          <TextBlock Text="Добавил новый сериал в папку — обнови список: значок у часов → «Обновить список сериалов». Сама программа в папку не заглядывает: пока сериал качается, отличить готовые серии от недокачанных нельзя."
                     Foreground="#b5bac1" FontSize="13" TextWrapping="Wrap" Margin="0,18,0,0" />
          <TextBlock Classes="label" Text="НЕ БРАТЬ ФАЙЛЫ, В КОТОРЫЕ ИДЁТ ЗАПИСЬ, МИНУТ" />
          <NumericUpDown Value="{Binding SettleMinutes, Mode=TwoWay}" Minimum="0" Maximum="240" Increment="1" />
          <TextBlock Text="Небольшая подстраховка на случай, если обновить список нажали прямо во время закачки. Полной гарантии это не даёт — дожидайся конца загрузки сам."
                     Foreground="#949ba4" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />

          <TextBlock Classes="label" Text="ПРОГРАММА ВОСПРОИЗВЕДЕНИЯ (ВХОДИТ В КОМПЛЕКТ — МЕНЯТЬ НЕ НУЖНО)" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Grid.Column="0" x:Name="MpvPathBox" Text="{Binding MpvPath, Mode=TwoWay}" />
            <Button Grid.Column="1" Content="Выбрать…" Click="OnBrowseMpv" Margin="8,0,0,0" />
          </Grid>
        </StackPanel>
      </TabItem>

      <TabItem Header="Проверка серий">
        <DockPanel Margin="28,24">
          <TextBlock DockPanel.Dock="Top" Classes="section" Text="Проверка серий" />
          <TextBlock DockPanel.Dock="Top" Foreground="#949ba4" FontSize="12" TextWrapping="Wrap"
                     Margin="0,0,0,10"
                     Text="Нажми «Проверить», если серии идут не по порядку. Программа покажет, как она поняла нумерацию каждого сериала, и предупредит, если номер сезона в названии файла не совпадает с папкой." />
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
            <Button Classes="accent" Content="Проверить" Click="OnInspectLibrary" />
            <TextBlock x:Name="LibraryStatus" Foreground="#949ba4" VerticalAlignment="Center" />
          </StackPanel>
          <ListBox x:Name="LibraryList" Background="#2b2d31">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="2,4" Spacing="2">
                  <TextBlock Text="{Binding Title}" Foreground="#f2f3f5" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Details}" Foreground="#b5bac1" FontSize="12" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Warning}" Foreground="#f0b232" FontSize="12"
                             TextWrapping="Wrap" IsVisible="{Binding HasWarning}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </TabItem>

      <TabItem Header="Порядок показа">
        <StackPanel Margin="28,24" MaxWidth="520" HorizontalAlignment="Left">
          <TextBlock Classes="section" Text="Порядок показа" />
          <TextBlock Text="Канал показывает сериалы по очереди: несколько серий одного, потом несколько серий следующего. Когда очередь возвращается к первому, он продолжает почти с того же места — как повтор на телевидении."
                     Foreground="#b5bac1" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,4" />
          <TextBlock Classes="label" Text="СКОЛЬКО СЕРИЙ ПОДРЯД ОДНОГО СЕРИАЛА" />
          <NumericUpDown Value="{Binding Window, Mode=TwoWay}" Minimum="1" Maximum="20" Increment="1" />
          <TextBlock Classes="label" Text="НА СКОЛЬКО СЕРИЙ СДВИГАТЬСЯ В СЛЕДУЮЩИЙ РАЗ" />
          <NumericUpDown Value="{Binding Step, Mode=TwoWay}" Minimum="1" Maximum="20" Increment="1" />
          <TextBlock Text="Например: показываем по 4 серии, сдвиг 2 — значит в следующий раз две серии повторятся, а две будут новые."
                     Foreground="#949ba4" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
          <TextBlock Classes="label" Text="НА СКОЛЬКО КРУГОВ ВПЕРЁД СОСТАВЛЯТЬ РАСПИСАНИЕ" />
          <NumericUpDown Value="{Binding CapRotations, Mode=TwoWay}" Minimum="1" Maximum="1000" Increment="10" />
          <TextBlock Text="Круг — это когда очередь обошла все сериалы по разу. Расписание составляется заранее на столько кругов, а потом повторяется. Обычно менять не нужно."
                     Foreground="#949ba4" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>
      </TabItem>

      <TabItem Header="Звук и экран">
        <StackPanel Margin="28,24" MaxWidth="500" HorizontalAlignment="Left">
          <TextBlock Classes="section" Text="Звук и экран" />
          <TextBlock Classes="label" Text="ГРОМКОСТЬ" />
          <NumericUpDown Value="{Binding Volume, Mode=TwoWay}" Minimum="0" Maximum="130" Increment="5" />
          <TextBlock Classes="label" Text="НА КАКОМ ЭКРАНЕ ПОКАЗЫВАТЬ" />
          <ComboBox x:Name="ScreenBox" HorizontalAlignment="Left" MinWidth="400"
                    SelectionChanged="OnScreenChanged" />
          <TextBlock Classes="label" Text="КУДА ВЫВОДИТЬ ЗВУК" />
          <ComboBox x:Name="AudioDeviceBox" HorizontalAlignment="Left" MinWidth="400"
                    SelectionChanged="OnAudioDeviceChanged">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Description}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <CheckBox x:Name="AutostartBox" Content="Включать канал сразу после входа в Windows"
                    Click="OnAutostartToggled" Margin="0,20,0,0" />
          <TextBlock Classes="label" Text="УПРАВЛЕНИЕ С КЛАВИАТУРЫ" />
          <CheckBox IsChecked="{Binding HotkeysEnabled, Mode=TwoWay}"
                    Content="Управлять каналом с клавиатуры" Margin="0,0,0,6" />
          <ComboBox x:Name="HotkeyModifiersBox" HorizontalAlignment="Left" MinWidth="200"
                    SelectionChanged="OnHotkeyModifiersChanged" />
          <TextBlock Text="Клавиши работают из любой программы: выбранные кнопки + Пробел — пауза, + стрелка вправо — следующая серия. Если такое сочетание уже занято другой программой, выбери другое. Сработает после перезапуска программы."
                     Foreground="#949ba4" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />

          <TextBlock Classes="label" Text="ЖУРНАЛ РАБОТЫ" />
          <CheckBox IsChecked="{Binding LoggingEnabled, Mode=TwoWay}"
                    Content="Записывать, что делает программа" Margin="0,0,0,6" />
          <Button Content="Открыть папку с журналом" Click="OnOpenLogFolder" HorizontalAlignment="Left" />
          <TextBlock Text="Журнал помогает понять, почему что-то пошло не так: в нём видно каждое действие и ответ проигрывателя. Файл сам ограничивается по размеру."
                     Foreground="#949ba4" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>
      </TabItem>

      <TabItem Header="Что в эфире">
        <Grid Margin="20,20" RowDefinitions="Auto,*,Auto" ColumnDefinitions="290,*">

          <TextBlock Grid.Row="0" Grid.Column="0" Classes="section" Text="Сериалы" />
          <TextBlock Grid.Row="0" Grid.Column="1" Classes="section" Text="Эфир" Margin="16,0,0,0" />

          <DockPanel Grid.Row="1" Grid.Column="0">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
              <Button Content="↑" Click="OnMoveUp" Width="42" />
              <Button Content="↓" Click="OnMoveDown" Width="42" />
              <TextBlock Text="перетаскивай мышью; галочка — идёт в эфире. Новые сериалы появляются здесь БЕЗ галочки: поставь её, когда закачка закончится."
                         Foreground="#949ba4" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
            <ListBox x:Name="ShowsList" Background="#2b2d31">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="Auto,*">
                    <CheckBox Grid.Column="0" IsChecked="{Binding IsIncluded, Mode=TwoWay}"
                              VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                               Margin="6,0,0,0" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>

          <DockPanel Grid.Row="1" Grid.Column="1" Margin="16,0,0,0">
            <Border DockPanel.Dock="Top" Background="#1e1f22" CornerRadius="6" Padding="14,12" Margin="0,0,0,10">
              <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Ellipse Classes="live" Width="10" Height="10" Fill="#f23f43" VerticalAlignment="Center" />
                  <TextBlock Text="СЕЙЧАС В ЭФИРЕ" Foreground="#949ba4" FontSize="12" FontWeight="Bold"
                             VerticalAlignment="Center" />
                  <Button Content="⟳" Click="OnRefreshNow" Padding="8,2" />
                </StackPanel>
                <TextBlock x:Name="NowPlaying" Text="—" Foreground="#f2f3f5" FontSize="16"
                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Border>
            <TextBlock DockPanel.Dock="Top" Text="ДАЛЬШЕ ПО ОЧЕРЕДИ (ДВОЙНОЙ ЩЕЛЧОК — ПЕРЕЙТИ К СЕРИИ)"
                       Foreground="#b5bac1" FontSize="12" FontWeight="Bold" Margin="2,0,0,6" />
            <ListBox x:Name="QueueList" Background="#2b2d31" FontSize="13" DoubleTapped="OnQueueJump">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>

          <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Background="#2b2d31"
                  CornerRadius="4" Padding="12,10" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" Spacing="14">
              <Button Classes="accent" Content="Применить к эфиру" Click="OnRebuild" />
              <CheckBox x:Name="PreserveCurrent" Content="не прерывать серию, которая идёт"
                        IsChecked="True" VerticalAlignment="Center" />
              <TextBlock x:Name="PlaylistStatus" Foreground="#949ba4" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Надписи на экране">
        <StackPanel Margin="28,24" MaxWidth="500" HorizontalAlignment="Left">
          <TextBlock Classes="section" Text="Надписи на экране" />
          <TextBlock Text="Всё, что канал рисует поверх видео. 0 секунд — не показывать вовсе."
                     Foreground="#b5bac1" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,4" />
          <TextBlock Classes="label" Text="НАЗВАНИЕ КАНАЛА НА ЗАСТАВКЕ" />
          <TextBox Text="{Binding ChannelName, Mode=TwoWay}" />
          <TextBlock Classes="label" Text="ЗАСТАВКА ПРИ ВКЛЮЧЕНИИ, СЕКУНД" />
          <NumericUpDown Value="{Binding SplashSeconds, Mode=TwoWay}" Minimum="0" Maximum="30" Increment="0.5" />
          <TextBlock Classes="label" Text="НАДПИСЬ «ДАЛЕЕ» ПРИ СМЕНЕ СЕРИАЛА, СЕКУНД" />
          <NumericUpDown Value="{Binding BumperSeconds, Mode=TwoWay}" Minimum="0" Maximum="30" Increment="0.5" />
          <TextBlock Classes="label" Text="ПОДПИСЬ СЕРИИ ВНИЗУ ЭКРАНА, СЕКУНД" />
          <NumericUpDown Value="{Binding PlashkaSeconds, Mode=TwoWay}" Minimum="0" Maximum="30" Increment="0.5" />
          <CheckBox IsChecked="{Binding ClockEnabled, Mode=TwoWay}" Content="Показывать часы в углу" />
          <CheckBox IsChecked="{Binding RetroTheme, Mode=TwoWay}" Content="Ретро-стиль надписей (тёплый жёлтый)" />
          <TextBlock Text="Изменения появятся после «Перезапустить канал» в меню значка у часов."
                     Foreground="#949ba4" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" />
        </StackPanel>
      </TabItem>

    </TabControl>

    <Border Grid.Row="1" Background="#2b2d31" Padding="20,14">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto">
        <TextBlock x:Name="VersionText" Grid.Column="0" VerticalAlignment="Center"
                   Foreground="#949ba4" FontSize="13" />
        <Button x:Name="UpdateButton" Grid.Column="1" Classes="accent" Content="Скачать обновление"
                IsVisible="False" Click="OnUpdate" Margin="12,0,0,0" Padding="12,6" />
        <TextBlock x:Name="StatusText" Grid.Column="2" VerticalAlignment="Center" Margin="16,0"
                   Foreground="#949ba4" FontSize="13" TextTrimming="CharacterEllipsis" />
        <Button x:Name="StartChannelButton" Grid.Column="3" Classes="accent" Content="Запустить канал"
                IsVisible="False" Click="OnStartChannel" Margin="0,0,12,0" />
        <Button x:Name="CheckUpdateButton" Grid.Column="4" Content="Проверить обновления"
                Click="OnCheckUpdates" Margin="0,0,12,0" />
        <Button Grid.Column="5" Classes="accent" Content="Сохранить" Click="OnSave" />
      </Grid>
    </Border>
  </Grid>
</Window>
